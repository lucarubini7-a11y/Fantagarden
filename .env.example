# Optional. The Vite client defaults to http://127.0.0.1:8000.
VITE_LOCAL_API_BASE=http://127.0.0.1:8000

# Optional. Enables the AI Advisor (see README). Never commit a real key here;
# export it in your shell or a local, gitignored .env instead.
ANTHROPIC_API_KEY=

# Optional. Enables live player status / injuries (see README). Set at most
# one of these - Highlightly is tried first if both are present.
HIGHLIGHTLY_API_KEY=
API_FOOTBALL_API_KEY=
